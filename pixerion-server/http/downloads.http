# Pixerion server — download jobs (ADMIN only)
#
# Downloads are a background job with SSE progress (ADR-0011), not a synchronous
# call. The lifecycle spans three endpoints:
#   POST /api/downloads              → 202 + { id, status, source }   (captures {{jobId}})
#   GET  /api/downloads/{id}         → status + summary/error once finished
#   GET  /api/downloads/{id}/events  → live progress as Server-Sent Events
#
# Prerequisites (globals persist across files within one env run):
#   1. auth.http  → "Login as admin"  populates {{authToken}}.
#   2. catalog.http → "Search"        populates {{bookId}}.
# Select the "dev" environment, then run top to bottom.

### Start a background download (ADMIN only) — 202 Accepted, captures {{jobId}}
# HEADS UP: this kicks off a REAL MangaDex download of every page to disk, under
# ~/.pixerion (the server's default root). Don't run casually.
# Absence is NOT a synchronous 404 here — it surfaces later as the job's
# NOT_FOUND status (see "Poll a download job's status"). An unknown source is
# still rejected synchronously with 400 (see the negative case below).
POST {{baseUrl}}/api/downloads?id={{bookId}}&source={{source}}
Authorization: Bearer {{authToken}}

> {%
    client.test("download accepted", () => client.assert(response.status === 202, "expected 202"));
    client.test("job id present", () => client.assert(response.body.id !== undefined, "no job id in body"));
    client.test("status is RUNNING", () => client.assert(response.body.status === "RUNNING", "expected RUNNING"));
    client.global.set("jobId", response.body.id);
    client.log("Started job " + response.body.id + " (source=" + response.body.source + ")");
%}

### Poll a download job's status (ADMIN only) — 404 if the job is unknown
# Re-run to watch it move RUNNING → COMPLETED (summary set) or FAILED/NOT_FOUND
# (error set). For live progress instead of polling, use the SSE request below.
GET {{baseUrl}}/api/downloads/{{jobId}}
Authorization: Bearer {{authToken}}
Accept: application/json

> {%
    client.test("status is 200", () => client.assert(response.status === 200, "expected 200"));
    client.test("id echoed", () => client.assert(response.body.id === client.global.get("jobId"), "job id mismatch"));
    client.test("status present", () => client.assert(response.body.status !== undefined, "no status in body"));
    if (response.body.summary) {
        client.log("COMPLETED '" + response.body.summary.book + "' -> " + response.body.summary.directory +
                   " (" + response.body.summary.pages + " pages, " + response.body.summary.chapters + " chapters)");
    } else if (response.body.error) {
        client.log(response.body.status + ": " + response.body.error);
    } else {
        client.log("Job " + response.body.id + " is " + response.body.status + " …");
    }
%}

### Stream live progress as Server-Sent Events (ADMIN only) — 404 if unknown
# Emits periodic `state` snapshots (status, chaptersDone/totalChapters, per-chapter
# written/total), then a terminal `completed` or `error` event and closes the stream.
# IntelliJ renders each event as it arrives; the connection stays open until the job
# finishes. Native EventSource can't send Authorization, so a browser needs a fetch-
# based SSE client — here the Bearer header is sent directly.
GET {{baseUrl}}/api/downloads/{{jobId}}/events
Authorization: Bearer {{authToken}}
Accept: text/event-stream

> {%
    client.test("events stream is 200", () => client.assert(response.status === 200, "expected 200"));
%}

### [negative] Status of an unknown job → 404
GET {{baseUrl}}/api/downloads/does-not-exist
Authorization: Bearer {{authToken}}

> {%
    client.test("unknown job is 404", () => client.assert(response.status === 404, "expected 404"));
%}

### [negative] Start a download for an unknown source → 400 (synchronous)
POST {{baseUrl}}/api/downloads?id={{bookId}}&source=nope
Authorization: Bearer {{authToken}}

> {%
    client.test("unknown source is 400", () => client.assert(response.status === 400, "expected 400"));
%}

### [negative] Start a download without a token → 401
POST {{baseUrl}}/api/downloads?id={{bookId}}&source={{source}}

> {%
    client.test("no token is 401", () => client.assert(response.status === 401, "expected 401"));
%}
